{
  "name": "admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev --force",
    "dev:demo": "VITE_ADMIN_DEMO=true react-router dev --force",
    "build": "tsc -b && react-router build",
    "build:demo": "VITE_ADMIN_DEMO=true bun run build",
    "format": "bun run biome format --write ./src",
    "lint": "bun run biome lint ./src",
    "preview": "vite preview",
    "serve:demo": "bunx --bun serve ./build/client -l 4175",
    "test": "bun test --preload ../frontend/happydom.ts --preload ../frontend/testing-library.ts",
    "test:coverage": "bun test --coverage --preload ../frontend/happydom.ts --preload ../frontend/testing-library.ts",
    "clean": "rm -rf node_modules build .vite"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-router/node": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tanstack/react-query": "^5.102.8",
    "api": "workspace:*",
    "better-auth": "^1.7.3",
    "frontend-common": "workspace:*",
    "hono": "^4.13.7",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.3",
    "isbot": "^5.2.2",
    "lucide-react": "^1.42.0",
    "msw": "2.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router": "^8.3.1",
    "shared": "workspace:*",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@react-router/dev": "^8.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "happy-dom": "^20.14.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  },
  "msw": {
    "workerDirectory": "./public"
  }
}