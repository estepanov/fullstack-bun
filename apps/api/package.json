{
  "name": "api",
  "scripts": {
    "dev": "bun run --watch src/index.ts ",
    "start": "bun src/index.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "format": "bun run biome format --write ./src",
    "lint": "bun run biome lint ./src",
    "test": "bun test --preload ./test/mocks/env.ts --preload ./test/mocks/redis.ts --preload ./test/mocks/db.ts",
    "test:coverage": "bun test --coverage --preload ./test/mocks/env.ts --preload ./test/mocks/redis.ts --preload ./test/mocks/db.ts",
    "clean": "rm -rf node_modules types"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.3",
    "@t3-oss/env-core": "^0.13.11",
    "@types/escape-html": "^1.0.4",
    "auth-email-security": "workspace:*",
    "better-auth": "^1.7.3",
    "better-auth-harmony": "^1.3.2",
    "drizzle-orm": "^0.45.2",
    "escape-html": "^1.0.3",
    "hono": "^4.13.7",
    "hono-rate-limiter": "^0.5.4",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "rate-limit-redis": "^6.0.1",
    "shared": "workspace:*",
    "uuid": "^14.0.2",
    "validation-better-auth": "^1.3.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "^1.4.2",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3"
  }
}
