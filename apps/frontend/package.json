{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev --force",
    "build": "tsc -b && react-router build",
    "format": "bun run biome format --write ./src",
    "lint": "bun run biome lint ./src",
    "preview": "vite preview",
    "test": "bun test --preload ./happydom.ts --preload ./testing-library.ts",
    "test:coverage": "bun test --coverage --preload ./happydom.ts --preload ./testing-library.ts"
  },
